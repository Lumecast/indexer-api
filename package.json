{
  "name": "lumecast-indexer-api",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain indexing service and query API for Lumecast (Stellar/Soroban)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:revert": "tsx src/db/migrate.ts --revert"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
